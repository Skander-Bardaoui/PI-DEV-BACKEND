// ═══════════════════════════════════════════════════════════════════════════
// 🚀 BACKEND CD PIPELINE - Continuous Deployment
// ═══════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'CI Build Number')
        string(name: 'GIT_COMMIT',   defaultValue: '', description: 'Git Commit SHA')
        string(name: 'GIT_BRANCH',   defaultValue: '', description: 'Git Branch')
    }

    environment {
        DOCKER_IMAGE     = 'imen077/pi-dev-backend'
        DOCKER_CREDS     = 'dockerhub-credentials'   // ID du credential Jenkins
        K8S_NAMESPACE    = 'production'
        K8S_DEPLOYMENT   = 'backend'
        IMAGE_TAG        = "${params.BUILD_NUMBER ?: env.BUILD_NUMBER}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────────────────
        stage('📋 Initialization') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '╔══════════════════════════════════════════════════════════╗'
                    echo '║            🚀 BACKEND CD PIPELINE                       ║'
                    echo '╚══════════════════════════════════════════════════════════╝'
                    echo """
                    📌 Deployment Information:
                       • CI Build:  #${env.IMAGE_TAG}
                       • Commit:    ${params.GIT_COMMIT}
                       • Branch:    ${params.GIT_BRANCH}
                       • Image:     ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}
                       • Namespace: ${env.K8S_NAMESPACE}
                       • Timestamp: ${new Date().format('yyyy-MM-dd HH:mm:ss')}
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔍 Checkout') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                checkout scm
                echo '✅ Code checked out'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🐳 Build & Push Docker Image') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: "${env.DOCKER_CREDS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "🐳 Building Docker image: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"

                            # Login DockerHub
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin

                            # Build image
                            docker build \
                                -t ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} \
                                -t ${env.DOCKER_IMAGE}:latest \
                                --build-arg BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                                --build-arg VERSION=${env.IMAGE_TAG} \
                                .

                            # Push vers DockerHub
                            docker push ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}
                            docker push ${env.DOCKER_IMAGE}:latest

                            # Logout
                            docker logout

                            echo "✅ Image pushed: ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}"
                        """
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🚀 Deploy to Kubernetes') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    sh """
                        echo "🚀 Deploying to Kubernetes namespace: ${env.K8S_NAMESPACE}"

                        # Mettre à jour l'image du deployment
                        kubectl set image deployment/${env.K8S_DEPLOYMENT} \
                            ${env.K8S_DEPLOYMENT}=${env.DOCKER_IMAGE}:${env.IMAGE_TAG} \
                            -n ${env.K8S_NAMESPACE}

                        echo "✅ Deployment image updated"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('⏳ Wait for Rollout') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    sh """
                        echo "⏳ Waiting for rollout to complete..."

                        kubectl rollout status deployment/${env.K8S_DEPLOYMENT} \
                            -n ${env.K8S_NAMESPACE} \
                            --timeout=5m

                        echo "✅ Rollout completed"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('✅ Verify Deployment') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    sh """
                        echo "✅ Verifying deployment..."

                        kubectl get pods -n ${env.K8S_NAMESPACE} -l app=${env.K8S_DEPLOYMENT}

                        kubectl get deployment ${env.K8S_DEPLOYMENT} \
                            -n ${env.K8S_NAMESPACE} \
                            -o wide

                        echo "✅ Deployment verified"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🧹 Cleanup') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    sh """
                        echo "🧹 Cleaning up local Docker images..."
                        docker rmi ${env.DOCKER_IMAGE}:${env.IMAGE_TAG} || true
                        docker rmi ${env.DOCKER_IMAGE}:latest || true
                        docker image prune -f || true
                        echo "✅ Cleanup done"
                    """
                }
            }
        }
    }

    post {
        success {
            echo '╔══════════════════════════════════════════════════════════╗'
            echo '║              ✅ DEPLOYMENT SUCCEEDED                    ║'
            echo '╚══════════════════════════════════════════════════════════╝'
            echo """
            📊 Deployment Summary:
               • Image:     ${env.DOCKER_IMAGE}:${env.IMAGE_TAG}
               • Namespace: ${env.K8S_NAMESPACE}
               • Duration:  ${currentBuild.durationString}
               • Status:    SUCCESS ✅
            """
        }

        failure {
            script {
                echo '╔══════════════════════════════════════════════════════════╗'
                echo '║               ❌ DEPLOYMENT FAILED                      ║'
                echo '╚══════════════════════════════════════════════════════════╝'

                // Rollback automatique
                sh """
                    echo "⏮️ Rolling back deployment..."
                    kubectl rollout undo deployment/${env.K8S_DEPLOYMENT} \
                        -n ${env.K8S_NAMESPACE} || true
                    echo "✅ Rollback triggered"
                """
            }
        }

        always {
            cleanWs()
        }
    }
}
