// ═══════════════════════════════════════════════════════════════════════════
// 🚀 BACKEND CD PIPELINE - Continuous Deployment
// ═══════════════════════════════════════════════════════════════════════════

pipeline {
    agent any

    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '', description: 'CI Build number')
        string(name: 'GIT_COMMIT',   defaultValue: '', description: 'Git commit hash')
        string(name: 'GIT_BRANCH',   defaultValue: 'main', description: 'Git branch')
    }

    environment {
        IMAGE_NAME           = 'imen077/pi-dev-backend'
        IMAGE_TAG            = "${params.BUILD_NUMBER ?: env.BUILD_NUMBER}"
        DOCKER_CREDENTIALS_ID = 'docker-credentials'  // ID exact dans Jenkins
        NAMESPACE            = 'production'
        DEPLOYMENT_NAME      = 'backend'
        ROLLOUT_TIMEOUT      = '10m'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        // ─────────────────────────────────────────────────────────────────
        stage('📋 Initialization') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '╔════════════════════════════════════════════════════════════╗'
                    echo '║               🚀 BACKEND CD PIPELINE                      ║'
                    echo '╚════════════════════════════════════════════════════════════╝'
                    echo """
                    📌 Deployment Information:
                       • CI Build:  #${params.BUILD_NUMBER}
                       • Commit:    ${params.GIT_COMMIT}
                       • Branch:    ${params.GIT_BRANCH}
                       • Image:     ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                       • Namespace: ${env.NAMESPACE}
                       • Timestamp: ${new Date().format('yyyy-MM-dd HH:mm:ss')}
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔍 Checkout') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                cleanWs()
                checkout scm
                echo '✅ Code checked out'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🐳 Build & Push Docker Image') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: "${env.DOCKER_CREDENTIALS_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "🐳 Building: ${env.IMAGE_NAME}:${env.IMAGE_TAG}"

                            # Login DockerHub
                            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin

                            # Build image
                            docker build \
                                -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} \
                                -t ${env.IMAGE_NAME}:latest \
                                --build-arg BUILD_DATE=\$(date -u +%Y-%m-%dT%H:%M:%SZ) \
                                --build-arg VCS_REF=${params.GIT_COMMIT} \
                                --build-arg VERSION=${env.IMAGE_TAG} \
                                .

                            # Push les deux tags
                            docker push ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                            docker push ${env.IMAGE_NAME}:latest

                            docker logout
                            echo "✅ Image pushed: ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                        """
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔐 Security Scan') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                echo '⚠️ Security scan skipped — continuing'
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🚀 Deploy to Kubernetes') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '🚀 Deploying to Kubernetes...'
                    sh """
                        echo "📝 Applying k8s manifests..."

                        # Appliquer les manifests s'ils existent
                        if [ -d k8s ]; then
                            [ -f k8s/configmap.yaml ]  && kubectl apply -f k8s/configmap.yaml  -n ${env.NAMESPACE}
                            [ -f k8s/secret.yaml ]     && kubectl apply -f k8s/secret.yaml     -n ${env.NAMESPACE}
                            [ -f k8s/pvc.yaml ]        && kubectl apply -f k8s/pvc.yaml        -n ${env.NAMESPACE}
                            [ -f k8s/postgres.yaml ]   && kubectl apply -f k8s/postgres.yaml   -n ${env.NAMESPACE}

                            echo "⏳ Waiting for PostgreSQL..."
                            kubectl wait --for=condition=ready pod \
                                -l app=postgres \
                                -n ${env.NAMESPACE} \
                                --timeout=3m || true

                            [ -f k8s/service.yaml ]    && kubectl apply -f k8s/service.yaml    -n ${env.NAMESPACE}
                            [ -f k8s/deployment.yaml ] && kubectl apply -f k8s/deployment.yaml -n ${env.NAMESPACE}
                        fi

                        echo "📋 Updating image to ${env.IMAGE_NAME}:${env.IMAGE_TAG}..."
                        kubectl set image deployment/${env.DEPLOYMENT_NAME} \
                            ${env.DEPLOYMENT_NAME}=${env.IMAGE_NAME}:${env.IMAGE_TAG} \
                            -n ${env.NAMESPACE}

                        echo "✅ Deployment applied"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('⏳ Wait for Rollout') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '⏳ Waiting for rollout...'
                    sh """
                        if ! kubectl rollout status deployment/${env.DEPLOYMENT_NAME} \
                            -n ${env.NAMESPACE} --timeout=${env.ROLLOUT_TIMEOUT}; then

                            echo "❌ Rollout failed — rolling back..."
                            kubectl rollout undo deployment/${env.DEPLOYMENT_NAME} -n ${env.NAMESPACE}
                            kubectl rollout status deployment/${env.DEPLOYMENT_NAME} \
                                -n ${env.NAMESPACE} --timeout=5m
                            exit 1
                        fi
                        echo "✅ Rollout successful!"
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('✅ Verify Deployment') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh """
                    echo "📊 Deployment Status:"
                    kubectl get deployment ${env.DEPLOYMENT_NAME} -n ${env.NAMESPACE}

                    echo "📦 Pods:"
                    kubectl get pods -n ${env.NAMESPACE} -l app=${env.DEPLOYMENT_NAME}

                    echo "🔌 Services:"
                    kubectl get svc -n ${env.NAMESPACE}

                    echo "📝 Recent Events:"
                    kubectl get events -n ${env.NAMESPACE} --sort-by=.lastTimestamp | tail -10
                """
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🧹 Cleanup') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh """
                    docker rmi ${env.IMAGE_NAME}:${env.IMAGE_TAG} || true
                    docker rmi ${env.IMAGE_NAME}:latest || true
                    docker image prune -f || true
                    echo "✅ Cleanup done"
                """
            }
        }
    }

    post {
        success {
            echo '╔════════════════════════════════════════════════════════════╗'
            echo '║              ✅ DEPLOYMENT SUCCEEDED                       ║'
            echo '╚════════════════════════════════════════════════════════════╝'
            echo """
            🎉 Deployment Summary:
               • Image:     ${env.IMAGE_NAME}:${env.IMAGE_TAG}
               • Namespace: ${env.NAMESPACE}
               • Duration:  ${currentBuild.durationString}
               • Status:    SUCCESS ✅
            """
        }

        failure {
            script {
                echo '╔════════════════════════════════════════════════════════════╗'
                echo '║               ❌ DEPLOYMENT FAILED                         ║'
                echo '╚════════════════════════════════════════════════════════════╝'
                echo """
                ❌ Deployment Failed:
                   • Image: ${env.IMAGE_NAME}:${env.IMAGE_TAG}
                   • Logs:  ${env.BUILD_URL}console
                """
                // Rollback de sécurité
                sh """
                    kubectl rollout undo deployment/${env.DEPLOYMENT_NAME} \
                        -n ${env.NAMESPACE} || true
                """
            }
        }

        always {
            cleanWs()
        }
    }
}