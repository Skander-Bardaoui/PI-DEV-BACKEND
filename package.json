  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "build": "npm install --include=dev && node node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",

    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",

    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",

    "seed:permissions": "ts-node src/scripts/seed-member-permissions.ts",
    "check:permissions": "npm run build && node dist/scripts/check-member-permissions.js",
    "test:permission-utils": "npm run build && node dist/scripts/test-permission-utils.js",
    "fix:permissions": "npm run build && node dist/scripts/fix-permission-format.js"
  },

