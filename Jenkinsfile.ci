// ═══════════════════════════════════════════════════════════════════════════
// 🔬 BACKEND CI PIPELINE - Continuous Integration
// ═══════════════════════════════════════════════════════════════════════════

pipeline {
    agent any
    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        PROJECT_NAME    = 'backend'
        NODE_VERSION    = '20'
        SONAR_PROJECT_KEY = 'backend'
        SONAR_HOST_URL  = 'http://192.168.56.10:30900'
        MIN_COVERAGE    = '70'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }

    stages {

        // ─────────────────────────────────────────────────────────────────
        stage('📋 Initialization') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '╔══════════════════════════════════════════════════════════╗'
                    echo '║            🔬 BACKEND CI PIPELINE                       ║'
                    echo '╚══════════════════════════════════════════════════════════╝'

                    checkout scm

                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH       = sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    env.GIT_AUTHOR       = sh(script: 'git log -1 --pretty=format:"%an"', returnStdout: true).trim()
                    env.GIT_MESSAGE      = sh(script: 'git log -1 --pretty=format:"%s"', returnStdout: true).trim()

                    echo """
                    📌 Build Information:
                       • Branch:    ${env.GIT_BRANCH}
                       • Commit:    ${env.GIT_COMMIT_SHORT}
                       • Author:    ${env.GIT_AUTHOR}
                       • Message:   ${env.GIT_MESSAGE}
                       • Timestamp: ${new Date().format('yyyy-MM-dd HH:mm:ss')}
                    """
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔧 Setup Environment') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    node --version
                    npm --version
                    echo "✅ Node.js ready"
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('📥 Install Dependencies') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    npm ci --prefer-offline --no-audit
                    echo "✅ Dependencies installed"
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔍 Code Linting') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    npm run lint || echo "⚠️ Linting issues found — continuing"
                    echo "✅ Linting done"
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🧪 Unit Tests') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    npm run test:cov -- --ci --reporters=default --reporters=jest-junit || true
                    echo "✅ Tests completed"
                '''
            }
            post {
                always {
                    junit testResults: '**/junit.xml', allowEmptyResults: true
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage/lcov-report',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('📊 Coverage Analysis') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    echo "📁 Checking coverage files..."
                    ls -la coverage/ || echo "❌ Coverage directory not found"

                    if [ -f coverage/lcov.info ]; then
                        echo "✅ LCOV report found"
                        echo "📄 Size: $(du -h coverage/lcov.info | cut -f1)"
                    else
                        echo "⚠️ LCOV report not found — SonarQube will run without coverage"
                    fi

                    if [ -f coverage/coverage-summary.json ]; then
                        COVERAGE=$(node -pe "JSON.parse(require('fs').readFileSync('coverage/coverage-summary.json')).total.lines.pct")
                        echo "📈 Line Coverage: ${COVERAGE}%"
                    else
                        echo "⚠️ Coverage summary not found"
                    fi
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔬 SonarQube Analysis') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    // Récupère le chemin du scanner installé via Jenkins Tools
                    def scannerHome = tool 'SonarScanner'

                    withSonarQubeEnv('SonarQube') {  // nom exact de ta config Jenkins
                        sh """
                            echo "🔬 Running SonarQube analysis..."
                            echo "📍 Scanner path: ${scannerHome}"

                            COVERAGE_ARGS=""
                            if [ -f coverage/lcov.info ]; then
                                COVERAGE_ARGS="-Dsonar.javascript.lcov.reportPaths=coverage/lcov.info -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info"
                                echo "✅ Coverage will be included"
                            else
                                echo "⚠️ No coverage file — running without coverage"
                            fi

                            ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                -Dsonar.projectName="Backend API" \
                                -Dsonar.projectVersion=${BUILD_NUMBER} \
                                -Dsonar.sources=src \
                                -Dsonar.tests=src \
                                -Dsonar.test.inclusions=**/*.spec.ts \
                                -Dsonar.coverage.exclusions=**/*.module.ts,**/main.ts,**/*.dto.ts,**/*.entity.ts \
                                -Dsonar.exclusions=node_modules/**,dist/**,coverage/**,**/*.test.ts \
                                \$COVERAGE_ARGS

                            echo "✅ SonarQube analysis completed"
                        """
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('⏳ Quality Gate') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    echo '⏳ Waiting for SonarQube Quality Gate...'
                    timeout(time: 5, unit: 'MINUTES') {
                        try {
                            def qg = waitForQualityGate abortPipeline: false
                            if (qg.status != 'OK') {
                                echo "⚠️ Quality Gate status: ${qg.status} — continuing anyway"
                                echo "📊 Details: ${SONAR_HOST_URL}/dashboard?id=${SONAR_PROJECT_KEY}"
                            } else {
                                echo '✅ Quality Gate passed!'
                            }
                        } catch (Exception e) {
                            echo "⚠️ Quality Gate error: ${e.message} — continuing"
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🏗️ Build Application') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    npm run build
                    if [ ! -d "dist" ]; then
                        echo "❌ Build failed: dist directory not found"
                        exit 1
                    fi
                    echo "📦 Build artifacts:"
                    ls -lh dist/
                    echo "✅ Build completed successfully"
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('🔐 Security Audit') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                sh '''
                    npm audit --audit-level=high || {
                        echo "⚠️ Security vulnerabilities found — continuing"
                        npm audit --audit-level=high --json > audit-report.json || true
                    }
                    echo "✅ Security audit completed"
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────────
        stage('📦 Archive Artifacts') {
        // ─────────────────────────────────────────────────────────────────
            steps {
                script {
                    archiveArtifacts artifacts: 'dist/**/*', fingerprint: true
                    archiveArtifacts artifacts: 'coverage/**/*', fingerprint: true, allowEmptyArchive: true
                    echo '✅ Artifacts archived'
                }
            }
        }
    }

    post {
        success {
            script {
                echo '╔══════════════════════════════════════════════════════════╗'
                echo '║              ✅ CI PIPELINE SUCCEEDED                   ║'
                echo '╚══════════════════════════════════════════════════════════╝'
                echo """
                📊 Build Summary:
                   • Build:    #${env.BUILD_NUMBER}
                   • Branch:   ${env.GIT_BRANCH}
                   • Commit:   ${env.GIT_COMMIT_SHORT}
                   • Duration: ${currentBuild.durationString}
                """

                try {
                    build job: 'pi-dev-backend-cd',
                          parameters: [
                              string(name: 'BUILD_NUMBER', value: env.BUILD_NUMBER),
                              string(name: 'GIT_COMMIT',   value: env.GIT_COMMIT_SHORT),
                              string(name: 'GIT_BRANCH',   value: env.GIT_BRANCH)
                          ],
                          wait: false
                    echo '✅ CD pipeline triggered'
                } catch (Exception e) {
                    echo "⚠️ CD trigger failed: ${e.message}"
                }
            }
        }

        failure {
            script {
                echo '╔══════════════════════════════════════════════════════════╗'
                echo '║               ❌ CI PIPELINE FAILED                     ║'
                echo '╚══════════════════════════════════════════════════════════╝'
                echo """
                ❌ Build Failed:
                   • Build:  #${env.BUILD_NUMBER}
                   • Branch: ${env.GIT_BRANCH}
                   • Commit: ${env.GIT_COMMIT_SHORT}
                   • Logs:   ${env.BUILD_URL}console
                """
            }
        }

        always {
            cleanWs deleteDirs: true, patterns: [
                [pattern: 'node_modules', type: 'INCLUDE'],
                [pattern: 'dist',         type: 'INCLUDE'],
                [pattern: 'coverage',     type: 'INCLUDE']
            ]
        }
    }
}
